{
  "name": "alesis-host",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @alesis/protocol && npm run build --workspace @alesis/web",
    "start": "npm run start --workspace @alesis/server",
    "test": "vitest run",
    "test:audio": "node scripts/audio-smoke.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev --workspace @alesis/server",
    "dev:web": "npm run dev --workspace @alesis/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
