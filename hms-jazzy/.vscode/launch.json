{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HMS Jazzy: browser helm",
      "type": "debugpy",
      "request": "launch",
      "module": "hms_jazzy",
      "args": ["--config", "${workspaceFolder}/board.toml"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "HMS Jazzy: native MuJoCo viewer",
      "type": "debugpy",
      "request": "launch",
      "module": "hms_jazzy",
      "args": ["--native", "--config", "${workspaceFolder}/board.toml"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
